{
  "name": "orderboard",
  "version": "1.3.98",
  "private": true,
  "description": "OrderBoard — gestion de commandes pour graphistes et artistes indépendants",
  "main": "desktop/main.js",
  "author": "OrderBoard",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.js",
    "typecheck": "tsc --noEmit",
    "desktop": "electron .",
    "dist": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/postcss": "^4",
    "@tldraw/tlschema": "^5.5.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4",
    "tldraw": "^5.5.2",
    "typescript": "^5",
    "zod": "^4.6.7"
  },
  "build": {
    "appId": "com.orderboard.app",
    "productName": "OrderBoard",
    "files": [
      "desktop/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    },
    "artifactName": "OrderBoard-Setup-${version}.${ext}",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "Rixx-blend",
        "repo": "Projet2",
        "releaseType": "release"
      }
    ],
    "compression": "store",
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server"
      }
    ],
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "afterPack": "scripts/after-pack.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rixx-blend/Projet2.git"
  }
}
